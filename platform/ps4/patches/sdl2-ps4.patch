+static SDL_bool PS4_IsLoggedIn(const OrbisUserServiceLoginUserIdList *users, int32_t userId) {
+    int i;
+    for (i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+        if (users->userId[i] == userId) {
+            return SDL_TRUE;
+        }
+    }
+    return SDL_FALSE;
+}
+
+static SDL_bool PS4_HasPadForUser(int32_t userId) {
+    int i;
+    for (i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+        if (slots[i].active && slots[i].userId == userId) {
+            return SDL_TRUE;
+        }
+    }
+    return SDL_FALSE;
+}
+
+static void PS4_RemovePad(PS4Pad *pad) {
+    SDL_Log("PS4_JoystickDetect: controller removed (user 0x%x, instance %i)\n",
+            (unsigned int) pad->userId, (int) pad->instance);
+    scePadClose(pad->handle);
+    pad->active = SDL_FALSE;
+    SDL_PrivateJoystickRemoved(pad->instance);
+}
+
+/* The index-th open pad, in slot order. */
+static PS4Pad *PS4_GetPad(int device_index) {
+    int i;
+    for (i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+        if (slots[i].active) {
+            if (device_index == 0) {
+                return &slots[i];
+            }
+            device_index--;
+        }
+    }
+    return NULL;
+}
